{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "measure.schema.json",
 "title": "Measures of a source",
 "description": "Which facts form one measure, and on which setup (data/findings/measures/<source id>.json, DATA-PIPELINE §3). The agent groups facts and names the setup; it writes no key, effort, level or campaign. Slots beyond §3's example (route, harness, mode, early_access, aggregation, setup, evaluated_by, component_of, other) hold facts the tree reads.",
 "type": "object",
 "properties": {
  "source": {
   "$ref": "common.schema.json#/$defs/source_id",
   "description": "The source file these measures cite."
  },
  "measures": {
   "type": "array",
   "description": "The measures.",
   "items": {
    "type": "object",
    "description": "One measure.",
    "properties": {
     "id": {
      "type": "string",
      "description": "Measure id, unique in the file (M1...).",
      "pattern": "^M[0-9]+$"
     },
     "setup": {
      "$ref": "common.schema.json#/$defs/setup_id",
      "description": "benchmarks.json setup id."
     },
     "facts": {
      "type": "object",
      "description": "The measure's facts by slot (vocab measure_slot).",
      "properties": {
       "value": {
        "description": "The measured value (score; for a cost-only measure null and `spend` given).",
        "anyOf": [
         {
          "$ref": "common.schema.json#/$defs/fact_ref"
         },
         {
          "type": "null"
         }
        ]
       },
       "runs": {
        "type": "array",
        "description": "Per-run values (run-score facts or cells) of a value that is a mean of runs: mean-of-runs recomputes it without the failed runs.",
        "items": {
         "$ref": "common.schema.json#/$defs/fact_ref"
        }
       },
       "model": {
        "type": "array",
        "description": "Model facts (names, API ids, mode).",
        "items": {
         "$ref": "common.schema.json#/$defs/fact_ref"
        }
       },
       "effort": {
        "type": "array",
        "description": "Configuration facts (label, setting, thinking on/off, no effort sent, budget, config history).",
        "items": {
         "$ref": "common.schema.json#/$defs/fact_ref"
        }
       },
       "run_date": {
        "type": "array",
        "description": "Run date / start / end facts.",
        "items": {
         "$ref": "common.schema.json#/$defs/fact_ref"
        }
       },
       "usage": {
        "type": "array",
        "description": "Usage facts (tokens, requests, cached share).",
        "items": {
         "$ref": "common.schema.json#/$defs/fact_ref"
        }
       },
       "spend": {
        "type": "array",
        "description": "Cost, currency, unit, basis, method, price table.",
        "items": {
         "$ref": "common.schema.json#/$defs/fact_ref"
        }
       },
       "version": {
        "description": "Version fact (campaign).",
        "anyOf": [
         {
          "$ref": "common.schema.json#/$defs/fact_ref"
         },
         {
          "type": "null"
         }
        ]
       },
       "judge": {
        "description": "Judge fact.",
        "anyOf": [
         {
          "$ref": "common.schema.json#/$defs/fact_ref"
         },
         {
          "type": "null"
         }
        ]
       },
       "anomalies": {
        "type": "array",
        "description": "failure / partial / cap facts.",
        "items": {
         "$ref": "common.schema.json#/$defs/fact_ref"
        }
       },
       "restated_from": {
        "description": "restated-from fact.",
        "anyOf": [
         {
          "$ref": "common.schema.json#/$defs/fact_ref"
         },
         {
          "type": "null"
         }
        ]
       },
       "same_runs_as": {
        "description": "same-runs-as fact.",
        "anyOf": [
         {
          "$ref": "common.schema.json#/$defs/fact_ref"
         },
         {
          "type": "null"
         }
        ]
       },
       "value_seen_in": {
        "type": "array",
        "description": "Captures of the source carrying this value (DATA-PIPELINE §3); the earliest is the run's default upper bound.",
        "items": {
         "$ref": "common.schema.json#/$defs/capture_id"
        }
       },
       "route": {
        "type": "array",
        "description": "Route chain facts (route; a harness that routes).",
        "items": {
         "$ref": "common.schema.json#/$defs/fact_ref"
        }
       },
       "harness": {
        "type": "array",
        "description": "Harness facts.",
        "items": {
         "$ref": "common.schema.json#/$defs/fact_ref"
        }
       },
       "mode": {
        "type": "array",
        "description": "Mode facts.",
        "items": {
         "$ref": "common.schema.json#/$defs/fact_ref"
        }
       },
       "early_access": {
        "type": "array",
        "description": "Early-access facts.",
        "items": {
         "$ref": "common.schema.json#/$defs/fact_ref"
        }
       },
       "aggregation": {
        "type": "array",
        "description": "Which runs the value covers.",
        "items": {
         "$ref": "common.schema.json#/$defs/fact_ref"
        }
       },
       "setup": {
        "type": "array",
        "description": "Facts proving the setup fields (tools regime, metric definition, headline metric, version, judge).",
        "items": {
         "$ref": "common.schema.json#/$defs/fact_ref"
        }
       },
       "evaluated_by": {
        "type": "array",
        "description": "Who ran it.",
        "items": {
         "$ref": "common.schema.json#/$defs/fact_ref"
        }
       },
       "component_of": {
        "type": "array",
        "description": "Composite membership.",
        "items": {
         "$ref": "common.schema.json#/$defs/fact_ref"
        }
       },
       "other": {
        "type": "array",
        "description": "Facts kept for the verifier (cross-checks), never read by the tree.",
        "items": {
         "$ref": "common.schema.json#/$defs/fact_ref"
        }
       },
       "legacy": {
        "type": "array",
        "description": "Migration: the legacy-row fact this measure carries (value null, model []: the tree is not applied).",
        "items": {
         "$ref": "common.schema.json#/$defs/fact_ref"
        }
       }
      },
      "required": [
       "value",
       "model"
      ],
      "unevaluatedProperties": false
     },
     "verified": {
      "description": "Verifier's re-derivation, or null.",
      "anyOf": [
       {
        "type": "object",
        "description": "Verification record.",
        "properties": {
         "by": {
          "type": "string",
          "description": "Verifier agent.",
          "minLength": 1
         },
         "at": {
          "$ref": "common.schema.json#/$defs/datetime"
         },
         "rederived": {
          "type": "boolean",
          "description": "Every number, label, fact type and identity re-derived from the saved copy."
         }
        },
        "required": [
         "by",
         "at",
         "rederived"
        ],
        "unevaluatedProperties": false
       },
       {
        "type": "null"
       }
      ]
     },
     "note": {
      "type": "string",
      "description": "Free note."
     },
     "legacy_ref": {
      "type": "object",
      "description": "Migration: the raw-data.csv row this converted measure replaces (the per-source diff is keyed by it).",
      "properties": {
       "line": {
        "type": "integer",
        "minimum": 1,
        "description": "Line of the row in raw-data.csv."
       },
       "row_sha256": {
        "$ref": "common.schema.json#/$defs/sha256",
        "description": "SHA-256 of the row's line as written (without its newline)."
       },
       "csv_sha256": {
        "$ref": "common.schema.json#/$defs/sha256",
        "description": "SHA-256 of that raw-data.csv."
       }
      },
      "required": [
       "line",
       "row_sha256"
      ],
      "unevaluatedProperties": false
     }
    },
    "required": [
     "id",
     "setup",
     "facts",
     "verified"
    ],
    "unevaluatedProperties": false
   },
   "minItems": 1
  }
 },
 "required": [
  "source",
  "measures"
 ],
 "unevaluatedProperties": false
}
